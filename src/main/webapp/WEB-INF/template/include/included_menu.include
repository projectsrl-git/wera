		<nav class="navbar-default navbar-static-side" role="navigation">
		
			<div class="sidebar-collapse">
			
				<ul class="nav metismenu" id="side-menu">
				
					<li class="nav-header">
						<div class="profile-element">
							<span>
								<img alt="image" src="img/${ALIAS_AZIENDA_UTENTE}-logo.png" />
								<!--<img alt="image" src="img/sirbi-logo.png" />-->
							 </span>
						</div>
						<div class="logo-element">
							WERA
						</div>
					</li>

					<#-- voce Home fissa per tutti i profili: la riga radice del menu
					     (id_menu_sup IS NULL, path='') non viene mai renderizzata dal
					     loop sottostante, che parte dal livello 1 -->
					<li<#if SELECTED_PATH?exists && SELECTED_PATH=''> class="active"</#if>>
						<a href="astro?FUNCTIONID=Home"><i class="fa fa-home"></i> <span class="nav-label">Home</span></a>
					</li>


					<#-- 2026-10-25 Centrale termica wera2026: voce NON presente nel menu del DB (condiviso con /wera).
					     CT_ACCESSO (S/N), CT_TITOLO_MENU e CT_NASCONDI_VOCE_WERA sono campi di sessione scritti dal
					     pacchetto net.projectsrl.wera.centraletermica (parametri ACCESSO.PROFILI, ETICHETTA.TITOLO,
					     MENU.VOCE_WERA.PROFILI). Alla prima pagina dopo il login non esistono ancora: la voce resta
					     nascosta e lo script in fondo al menu chiede l'accesso al server. -->
					<#if !(CT_ACCESSO?? && CT_ACCESSO == 'N')>
					<li id="ct-voce-menu"<#if CT_PAGINA??> class="active"</#if><#if !CT_ACCESSO??> style="display:none"</#if>>
						<a href="astro?FUNCTIONID=CentraleTermica"><i class="fa fa-fire"></i> <span class="nav-label" id="ct-voce-menu-testo"><#if CT_TITOLO_MENU??>${CT_TITOLO_MENU?html}<#else>Centrale termica</#if></span></a>
					</li>
					</#if>

					<#list menu_list as menuItem>
					<#if menuItem.getItemLevel()=1>
					<li<#if SELECTED_PATH?starts_with(menuItem.getPath())> class="active"</#if>>
						<#if menuItem.hasChildren()>
						<a href="#"><i class="${menuItem.getIcon()}"></i> <span class="nav-label">${menuItem.getLabel()}</span>&nbsp;<span class="fa arrow"></span></a>
						<ul class="nav nav-second-level collapse">
							<#list menu_list as menuItemLevel2>
							<#if menuItemLevel2.getMenuIdSup()=menuItem.getMenuId()>
							<#if menuItemLevel2.hasChildren()>							
							<li<#if SELECTED_PATH?starts_with(menuItemLevel2.getPath())> class="active"</#if>>
                                <a href="#">${menuItemLevel2.getLabel()}<span class="fa arrow"></span></a>
                                <ul class="nav nav-third-level">
									<#list menu_list as menuItemLevel3>
									<#if menuItemLevel3.getMenuIdSup()=menuItemLevel2.getMenuId()>
                                    <li<#if menuItemLevel3.getPath()=SELECTED_PATH> class='active'</#if>>
                                        <a href="${menuItemLevel3.getLink()}">${menuItemLevel3.getLabel()}</a>
                                    </li>
									</#if>
									</#list>								
                                </ul>							
							</li>
							<#else>
							<li<#if menuItemLevel2.getPath()=SELECTED_PATH> class='active'</#if>><a href="${menuItemLevel2.getLink()}">${menuItemLevel2.getLabel()}</a></li>
							</#if>
							</#if>
							</#list>								
						</ul>
						<#else>
						<a href="${menuItem.getLink()}"><i class="${menuItem.getIcon()}"></i> <span class="nav-label">${menuItem.getLabel()}</span></a>
						</#if>
					</li>
					</#if>
					</#list>
					
					
					
				<#-- 2026-10-25 Centrale termica: accesso alla voce (prima pagina dopo il login) e vecchia voce
				     "Centrali termiche" nascosta ai profili fuori da MENU.VOCE_WERA.PROFILI. -->
				<#if !CT_ACCESSO?? || (CT_NASCONDI_VOCE_WERA?? && CT_NASCONDI_VOCE_WERA == 'S')>
				<script>
				(function ($) {
					if (!$) { return; }
					function nascondiVoceWera() {
						$('#side-menu > li').each(function () {
							var $li = $(this), $link = $li.find('a[href*="FUNCTIONID="]'), tutti = $link.length > 0;
							if ($li.attr('id') === 'ct-voce-menu') { return; }
							$link.each(function () {
								if (!/FUNCTIONID=[A-Za-z]*FileManager($|[^A-Za-z])/.test(this.getAttribute('href') || '')) { tutti = false; }
							});
							if (tutti) { $li.hide(); }
						});
					}
					$(function () {
						<#if CT_ACCESSO??>
						nascondiVoceWera();
						<#else>
						$.ajax({ url: 'astro', data: { FUNCTIONID: 'CentraleTermicaDati', OPERAZIONE: 'accesso' }, dataType: 'json', cache: false })
							.done(function (j) {
								var a = j && j.accesso;
								if (!a) { return; }
								if (a.abilitato) {
									if (a.titolo) { $('#ct-voce-menu-testo').text(a.titolo); }
									$('#ct-voce-menu').show();
								} else {
									$('#ct-voce-menu').remove();
								}
								if (a.nascondi_voce_wera) { nascondiVoceWera(); }
							});
						</#if>
					});
				}(window.jQuery));
				</script>
				</#if>

			</div>
		</nav>