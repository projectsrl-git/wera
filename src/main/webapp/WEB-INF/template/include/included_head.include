    <script src="js/plugins/pace/pace.min.js"></script>
    
    <script>
		  let paceTextTimer;
		  let paceDone = false;
		
		  Pace.on('start', function() {
		    const paceEl = document.querySelector('.pace');
		    if (!paceEl) return;
		
		    // All'inizio la barra è bassa e senza testo
		    paceEl.style.height = '2px';
		    paceEl.style.position = 'relative';
		
		    // Se il testo non esiste, crealo ma NON mostrarlo subito
		    if (!document.getElementById('pace-text')) {
		      const textEl = document.createElement('div');
		      textEl.id = 'pace-text';
		      Object.assign(textEl.style, {
		        position: 'absolute',
		        top: '50%',
		        left: '50%',
		        transform: 'translate(-50%, -50%)',
		        color: '#fff',
		        fontWeight: 'bold',
		        fontSize: '14px',
		        zIndex: '9999',
		        pointerEvents: 'none',
		        display: 'none' // nascosto inizialmente
		      });
		      textEl.textContent = 'Caricamento della pagina in corso, attendere qualche secondo.';
		      paceEl.appendChild(textEl);
		    }
		
		    // Dopo 2 secondi, se ancora non finito, mostro testo e aumento altezza barra
		    paceTextTimer = setTimeout(() => {
		      if (!paceDone) {
		        paceEl.style.height = '22px';
		        paceEl.style.backgroundColor = '#1ab394';  // verde come richiesto
		        const textEl = document.getElementById('pace-text');
		        if (textEl) textEl.style.display = 'block';
		      }
		    }, 2000);
		  });
		
		  Pace.on('done', function() {
		    paceDone = true;
		    clearTimeout(paceTextTimer);
		
		    const paceEl = document.querySelector('.pace');
		    if (paceEl) {
		      paceEl.style.height = '2px';
		    }
		
		    const textEl = document.getElementById('pace-text');
		    if (textEl) {
		      textEl.style.display = 'none';
		    }
		  });
	</script>

    
